        {"id":"rope-pressdown","name":"Rope Pressdown","sets":2,"minReps":8,"maxReps":12,"increment":5,"restSeconds":90,"muscles":["triceps"],"supersetGroup":"A-ARMS","supersetOrder":2,"substitutes":[{"id":"straight-bar-pressdown","name":"Straight-Bar Pressdown"}]}
